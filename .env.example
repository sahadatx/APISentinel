APISENTINEL_DATABASE_URL=sqlite:///./apisentinel.db
APISENTINEL_API_PREFIX=/api/v1
APISENTINEL_MAX_REQUESTS_PER_MINUTE=30
APISENTINEL_REQUEST_TIMEOUT_SECONDS=5
APISENTINEL_ALLOW_ACTIVE_TESTS=false
APISENTINEL_ALLOW_LOCAL_LAB=false
APISENTINEL_RUNNER_LAB_ALLOW_HTTP=false
APISENTINEL_RUNNER_CONNECT_TIMEOUT_SECONDS=3
APISENTINEL_RUNNER_READ_TIMEOUT_SECONDS=5
APISENTINEL_RUNNER_WRITE_TIMEOUT_SECONDS=5
APISENTINEL_RUNNER_POOL_TIMEOUT_SECONDS=2
APISENTINEL_RUNNER_TOTAL_TIMEOUT_SECONDS=90
APISENTINEL_RUNNER_MAX_RESPONSE_BYTES=1000000
APISENTINEL_OPENAPI_MAX_DOCUMENT_BYTES=1000000
APISENTINEL_ENABLED_SECURITY_TESTS=response.header.content_type_options,response.header.strict_transport_security,authentication.unauthenticated_access,authorization.sensitive_property_observation,resource.rate_limit_observation,authorization.bola.synthetic_pair,authorization.function_role_pair
APISENTINEL_RUNNER_MAX_CONCURRENCY=2
APISENTINEL_RUNNER_MAX_REDIRECTS=3
APISENTINEL_RUNNER_LAB_ALLOWED_PORTS=
APISENTINEL_RUNNER_EGRESS_ALLOWED_CIDRS=
# Host-run development API; Docker Compose overrides this with the private service DNS name.
APISENTINEL_APK_PARSER_URL=http://172.24.0.2:8090
APISENTINEL_ENVIRONMENT=development
APISENTINEL_SESSION_TTL_MINUTES=480
APISENTINEL_COOKIE_SECURE=false
APISENTINEL_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
# Provision in a protected secret store and back it up separately from the database.
APISENTINEL_CREDENTIAL_ENCRYPTION_KEY=
APISENTINEL_CREDENTIAL_ENCRYPTION_KEY_NEXT=
APISENTINEL_CREDENTIAL_ENCRYPTION_PROVIDER=fernet
# Production: choose aws_kms, configure the key ARN/alias and region, and grant
# the workload identity only kms:GenerateDataKey and kms:Decrypt on that key.
APISENTINEL_CREDENTIAL_KMS_KEY_ID=
APISENTINEL_CREDENTIAL_KMS_KEY_ID_NEXT=
APISENTINEL_CREDENTIAL_KMS_REGION=
